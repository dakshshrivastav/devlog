# --- Raw user captures and generated session data ---
# Private audio, photos, transcripts and generated documentation bundles.
# Nothing under the runtime data directory is ever committed.
/data/
/out/
/captures/
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.webm
# Fixture media is intentionally tracked; runtime uploads are not.
!fixtures/**/*.png
!fixtures/**/*.jpg
!fixtures/**/*.jpeg
!fixtures/**/*.webp

