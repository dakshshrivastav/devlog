# Devlog server configuration.
# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Providers -------------------------------------------------------------
# Optional AI Studio key. If blank, Devlog uses Google Cloud ADC when available.
GEMINI_API_KEY=

# Vertex AI ADC settings. GOOGLE_CLOUD_PROJECT defaults to the quota/project id
# in ~/.config/gcloud/application_default_credentials.json; set it explicitly if needed.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# ElevenLabs key. Required for Scribe v2 batch transcription, realtime
# transcription, and minting browser single-use tokens.
ELEVENLABS_API_KEY=

# Optional model override. Defaults by auth mode:
# - GEMINI_API_KEY: gemma-4-26b-a4b-it (Gemini Developer API)
# - ADC: gemma-4-26b-a4b-it-maas (Vertex AI global endpoint)
GEMMA_MODEL=

# Realtime STT model id.
SCRIBE_REALTIME_MODEL=scribe_v2_realtime

# Batch STT model id.
SCRIBE_MODEL=scribe_v2

# --- Server ----------------------------------------------------------------
PORT=8787

# Where session directories are written. Defaults to ./data (gitignored).
DATA_DIR=./data

# Where generated documentation bundles are staged. Defaults to <DATA_DIR>/out.
OUTPUT_DIR=

# --- Mock mode -------------------------------------------------------------
# 1 = serve fixtures/session-01 through the real routes and skip every provider
# call. Auto-enabled when neither Gemma auth nor ElevenLabs is configured.
MOCK=

# --- Generation limits (docs/references/gemma4-gemini-api.md) --------------
MAX_PHOTOS_PER_CALL=8
MAX_VIDEO_FRAMES=4
# Video ingest requires ffmpeg and ffprobe installed on PATH.
MAX_PHOTO_BYTES=5242880
MAX_INLINE_PAYLOAD_BYTES=20971520
