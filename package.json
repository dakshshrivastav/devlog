{
  "name": "devlog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Automatic hardware documentation synthesized from speech, bench photos and git history.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run live",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "fixture": "tsx scripts/build-fixture.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@google/genai": "^2.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "mermaid": "^12.1.0",
    "multer": "^2.0.0",
    "nanoid": "^5.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
